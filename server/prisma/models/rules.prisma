model Permit {
  id          String   @id @default(uuid())
  type        String   @unique @default("r") //r,rw,full
  description String?
  expiresAt   DateTime
  /* Default fields---------------------------------------------- */
  isDeleted    Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())
  // owner    Employee[] @relation("EmplPermit")
}