model Employee {
  id           String  @id @default(uuid())
  employeeId   String  @unique
  fullName     String
  email        String?  @unique
  phone        String?  @unique 
  passwordHash String
  role         String  @default("worker") // admin, coordinator, worker
  isBlocked    Boolean @default(false)
  /* Default fields---------------------------------------------- */
  isDeleted    Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

/* -------------------------------------------------------------------------- */
  baseId String?
  base   Base?   @relation(fields: [baseId], references: [id])

  positionId Int      @default(1)
  position    Position @relation("EmplPostion", fields: [positionId], references: [id])

  teamMemberships TeamMember[]
  workAssignments WorkAssignment[]
  team Team[] @relation("TeamCreator")
  ledTeams Team[] @relation("MakeLeader")
}

model Position {
  id   Int    @id @default(autoincrement())
  name String @unique
  /* Default fields---------------------------------------------- */
  isDeleted    Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())
/* -------------------------------------------------------------------------- */
  employee Employee[] @relation("EmplPostion")
}

model Base {
  id        String     @id @default(uuid())
  name      String
  city      String
  address   String?
  /* Default fields---------------------------------------------- */
  isDeleted    Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())
  /* -------------------------------------------------------------------------- */
  employees Employee[]
  // equipment Equipment[]
  
}
